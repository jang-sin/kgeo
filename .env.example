# kgeo 수집기 DB 접속정보 (예시)
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#     copy .env.example .env
#
# .env 는 .gitignore 에 등록되어 있다. 절대 커밋하지 말 것.
# 이 저장소는 공개이고 main.py 가 GitHub raw 에서 코드를 받아 실행하므로,
# 접속정보가 저장소에 들어가면 그대로 공개된다.

# --- Oracle 접속 ---
DB_USER=
DB_PASSWORD=

# 형식: host:port/service_name   (예: 10.0.0.10:1521/ORCLPDB)
# 또는 tnsnames.ora 에 등록된 별칭
DB_DSN=

# --- 대상 테이블 접미사 (선택) ---
# 평소에는 비워 둔다. 실행할 때마다 화면에서 물어본다.
#
#   대상 테이블 접미사를 입력하세요 (숫자, 예: 1) > 1
#     -> KGEO_OWNER_HIST_1, KGEO_JIGARST_1, ... 에 저장
#
# 스케줄러나 백그라운드로 돌려 입력을 받을 수 없을 때만 값을 적는다.
# 값이 있으면 묻지 않고 그대로 쓴다. 숫자만 허용.
TABLE_SUFFIX=

# --- 수집 속도 (선택) ---
# 실측: 초당 21요청에서 차단(약 1시간 지속), 14요청은 전량 통과.
# 기본값 0.05 = 전체 초당 20요청 상한. 차단이 잦으면 0.1 로 올린다.
MIN_INTERVAL=0.05
